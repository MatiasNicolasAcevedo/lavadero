# Variables para desarrollo local. Copiar sin editar:  cp env.properties.example env.properties
# Spring lo importa desde server/ (spring.config.import=optional:env.properties) y los scripts lo exportan.
# Valores SOLO para local: coinciden con server/docker-compose.yml. Nunca usar en producción.
DB_URL=jdbc:postgresql://localhost:5432/lavadero
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_USER=lavadero_user
DB_PASSWORD=lavadero_pass
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# Clave HMAC en Base64 (>= 32 bytes) generada para local con: openssl rand -base64 32
SECRET=lPYGIpwTN6NMYJQ3dVp9rDjVu6CU8Vn17qO5hBnfDtA=
