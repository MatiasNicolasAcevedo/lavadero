# https://editorconfig.org — refleja el estilo actual del código
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[server/pom.xml]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
